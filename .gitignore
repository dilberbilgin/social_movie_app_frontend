

# --- KENDİ GELİŞTİRDİĞİN SOSYAL APP PROJESİ .GITIGNORE ---

# 1. BAĞIMLILIKLAR (Dependencies)
# Klasör başında / olmadığı için alt klasörlerdeki (frontend/node_modules gibi) yapıları da kapsar.
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 2. BACKEND (Spring Boot / Maven / Gradle)
target/
build/
.mvn/wrapper/maven-wrapper.jar
**/.apt_generated
**/.classpath
**/.factorypath
**/.project
**/.settings
**/.springBeans
**/.sts4-cache

# 3. GÜVENLİK (Secrets - ASLA GITHUB'A GİTMEMELİ)
# Hem .env dosyalarını hem de Java application.properties dosyalarını gizler.
.env*
**/src/main/resources/application.properties
**/src/main/resources/application.yml
**/src/main/resources/application-*.properties
**/src/main/resources/application-*.yml
*.pem
*.jks

# 4. FRONTEND (Next.js / Testing / Production)
.next/
out/
coverage/
*.tsbuildinfo
next-env.d.ts
.vercel

# 5. IDE & SİSTEM DOSYALARI (Kişisel Ayarlar)
.idea/
*.iws
*.iml
*.ipr
.vscode/
.DS_Store
Thumbs.db
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# 6. LOGLAR (Hata kayıtları)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log